# CQ1: What do I need to do to complete my weekly review?
# Every step under the plan, at any depth, with its phase and what it waits on.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX ch: <https://clearhead.us/vocab/clearhead#>
SELECT ?phase ?step ?waitsOn WHERE {
  ?plan rdfs:label "weekly review"@en ;
        obo:BFO_0000178+ ?s .
  ?s a obo:IAO_0000007 ; rdfs:label ?step .
  OPTIONAL { ?p obo:BFO_0000178 ?s ; a obo:IAO_0000007 ; rdfs:label ?phase }
  OPTIONAL { ?s ch:waitsOn/rdfs:label ?waitsOn }
}
ORDER BY ?phase ?step
