@prefix actions: <https://clearhead.us/vocab/actions/v4#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# Invalid Example: circular Action dependency
# =============================================================================
#
# Action A is_successor_of Action B and Action B is_successor_of Action A.
# NoCyclicDependenciesShape now targets Prescriptive ICE (ont00000965), so it
# must catch cycles among Actions, not only Plans.
# =============================================================================

<urn:uuid:0a1b2c3d-1111-7000-8000-000000000001> a actions:Action ;
    rdfs:label "Action A" ;
    actions:hasUUID "0a1b2c3d-1111-7000-8000-000000000001" ;
    cco:ont00001868 actions:NotStarted ;
    cco:ont00001775 <urn:uuid:0a1b2c3d-1111-7000-8000-000000000002> .  # A is_successor_of B

<urn:uuid:0a1b2c3d-1111-7000-8000-000000000002> a actions:Action ;
    rdfs:label "Action B" ;
    actions:hasUUID "0a1b2c3d-1111-7000-8000-000000000002" ;
    cco:ont00001868 actions:NotStarted ;
    cco:ont00001775 <urn:uuid:0a1b2c3d-1111-7000-8000-000000000001> .  # B is_successor_of A (CIRCULAR!)
