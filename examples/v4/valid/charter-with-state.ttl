@prefix actions: <https://clearhead.us/vocab/actions/v4#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# Valid Example: Charter lifecycle status
# =============================================================================
#
# A Charter carries its lifecycle status via actions:hasCharterState, pointing
# at a charter-specific status individual. These individuals are distinct from
# the Action status set (actions:InProgress etc.) so the two lifecycles never
# collide. Regression that the canonical projection's charterState publication
# validates against the v4.5 shapes + ontology.
# =============================================================================

<urn:uuid:0a1b2c3d-0000-7000-8000-0000000000c1> a actions:Charter ;
    rdfs:label "RDF Publication" ;
    actions:hasUUID "0a1b2c3d-0000-7000-8000-0000000000c1" ;
    actions:hasCharterState actions:CharterActive .
