@prefix actions: <https://clearhead.us/vocab/actions/v4#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# Valid Example: Action-to-Action dependency ordering
# =============================================================================
#
# The canonical projection emits is_successor_of (cco:ont00001775) BETWEEN
# ACTIONS — this is what the "<" predecessor syntax and the implicit edges of
# the "~" sequential-children syntax produce. This example locks in that the
# SHACL SuccessorDomainShape accepts Actions as successor subjects (regression
# for the pre-v4.3 shape that required Plan instances and rejected real
# workspaces).
# =============================================================================

<urn:uuid:0a1b2c3d-0000-7000-8000-000000000002> a actions:Action ;
    rdfs:label "Run 5K" ;
    actions:hasUUID "0a1b2c3d-0000-7000-8000-000000000002" ;
    cco:ont00001868 actions:NotStarted ;
    cco:ont00001775 <urn:uuid:0a1b2c3d-0000-7000-8000-000000000001> .  # is_successor_of "Lace shoes"

<urn:uuid:0a1b2c3d-0000-7000-8000-000000000001> a actions:Action ;
    rdfs:label "Lace shoes" ;
    actions:hasUUID "0a1b2c3d-0000-7000-8000-000000000001" ;
    cco:ont00001868 actions:NotStarted .
